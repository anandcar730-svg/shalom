PORT=3000
# Public URL of this app (used in WhatsApp cancel links)
BASE_URL=https://pray.shalomchurch.co.in
ADMIN_PASSWORD=change-me
# Church timezone offset used for slot times
TZ_OFFSET=+05:30
DEFAULT_COUNTRY_CODE=91
# Reception login (books the extra slots). Leave blank to turn reception off.
RECEPTION_PASSWORD=
# Admin's WhatsApp number (gets a message for every new booking)
ADMIN_WHATSAPP=919400328000

# --- WhatsApp provider: "meta" (Cloud API) or "twilio". Leave blank = log only ---
WHATSAPP_PROVIDER=
# Meta WhatsApp Cloud API
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Set to true once the templates in WHATSAPP_TEMPLATES.md are approved by Meta
META_USE_TEMPLATES=false
# Webhook (button replies "I am here" / "NO"): the callback URL is https://YOUR-DOMAIN/webhook
META_VERIFY_TOKEN=
# App secret (Meta app: Settings > Basic). Lets the app reject fake webhook calls.
META_APP_SECRET=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
